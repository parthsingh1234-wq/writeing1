{
  "name": "article-vault",
  "version": "1.0.0",
  "description": "Article Vault - Production Full-Stack Editorial CMS & Publishing Platform",
  "main": "api/index.js",
  "scripts": {
    "postinstall": "npm install --prefix client && npm install --prefix server",
    "build": "npm run build --prefix client",
    "start": "node server/src/app.js",
    "server": "npm start --prefix server",
    "client": "npm run dev --prefix client",
    "seed": "node server/src/utils/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.1",
    "multer": "^1.4.5-lts.1",
    "sanitize-html": "^2.12.1"
  },
  "keywords": [
    "cms",
    "editorial",
    "react",
    "vite",
    "express",
    "mongodb",
    "tiptap"
  ],
  "author": "Parth Singh",
  "license": "MIT"
}
